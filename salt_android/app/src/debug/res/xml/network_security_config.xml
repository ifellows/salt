<?xml version="1.0" encoding="utf-8"?>
<!--
    Debug-build override of network_security_config.xml.

    Android merges build-type resources over src/main, so DEBUG builds use
    this file and RELEASE builds use src/main/res/xml/network_security_config.xml.

    Cleartext (plain HTTP) is PERMITTED here so developers can point a debug
    build at a local-network server (e.g. http://192.168.x.x:3000 or the
    emulator's http://10.0.2.2:3000) without TLS. This permissiveness never
    ships — release builds get the cleartext-forbidden config.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
