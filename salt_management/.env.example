# SALT Management Server — environment defaults
#
# Copy to .env (which is gitignored) and customize. All values are optional;
# defaults shown.

# HTTP port the app listens on inside the container. The compose file maps it
# to 127.0.0.1:3000 on the host.
PORT=3000

NODE_ENV=production

# Session signing key. Leave blank and the entrypoint generates one on first
# boot, persisting to /app/data/.session-secret. Set it explicitly if your ops
# story prefers an external secret store.
SESSION_SECRET=

# --- MCP report builder (ON by default) ------------------------------------
# Exposes an MCP server + OAuth so an admin's own AI agent (claude.ai, Claude
# Code, Claude Desktop) can build Quarto reports. See README / docs.
# Enabled unless set to a falsy value (false/0/no/off):
MCP_ENABLED=true
# Public HTTPS base URL the MCP server is reachable at (the OAuth issuer +
# resource identifier). Must be the externally reachable URL, e.g.
# https://salt.example.org . Defaults to http://localhost:PORT for local dev.
MCP_PUBLIC_URL=
# Access-token lifetime (seconds; default 1800 = 30 min). Silently refreshed.
MCP_ACCESS_TTL_SECONDS=1800
# Absolute session cap (seconds; default 21600 = 6 h). Refresh is refused past
# this regardless of access-token lifetime — the user must re-authenticate.
MCP_SESSION_MAX_SECONDS=21600
# Editable report-generation instructions (the AI system prompt). Defaults to
# data/reports/report-instructions.md, seeded from the shipped default on first
# run and editable thereafter. Override the path here if desired.
MCP_INSTRUCTIONS_FILE=
# Editable example report templates directory (seeded from shipped defaults on
# first run). Defaults to data/reports/templates.
MCP_TEMPLATES_DIR=
# Backstop truncation limits for tool payloads (very large by default; rarely
# changed): markdown preview, render log, and data-profile text.
MCP_MAX_MD_CHARS=5000000
MCP_MAX_LOG_CHARS=1000000
MCP_PROFILE_CHAR_CAP=2000000
