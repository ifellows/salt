# SALT Management Server — environment defaults
#
# Copy to .env (which is gitignored) and customize. All values are optional;
# defaults shown.

# HTTP port the app listens on inside the container. The compose file maps it
# to 127.0.0.1:3000 on the host.
PORT=3000

NODE_ENV=production

# Session signing key. Leave blank and the entrypoint generates one on first
# boot, persisting to /app/data/.session-secret. Set it explicitly if your ops
# story prefers an external secret store.
SESSION_SECRET=
